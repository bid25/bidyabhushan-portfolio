{
  "css.lint.unknownAtRules": "ignore",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/*.tsbuildinfo": true,
    "**/.next": true,
    "**/.agents": true,
    "**/.claude": true,
    "**/.codex": true,
    "**/.cursor": true,
    "**/.impeccable": true,
    "**/.vscode": true,
    "**/next-env.d.ts": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, tsconfig.json, next.config.ts, eslint.config.mjs, postcss.config.mjs, components.json",
    "README.md": "AGENTS.md, CLAUDE.md"
  }
}
